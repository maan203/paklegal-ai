{
  "name": "paklegal-ai",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "rag:build": "node scripts/rag/build-knowledge.mjs",
    "rag:index": "wrangler vectorize create paklegal-laws --dimensions=1024 --metric=cosine && wrangler vectorize create-metadata-index paklegal-laws --property-name=law --type=string",
    "rag:ingest": "node scripts/rag/ingest.mjs",
    "rag:eval": "node scripts/rag/eval.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "rag:eval-answers": "node scripts/rag/eval-answers.mjs",
    "speech:eval": "node scripts/speech/eval-speech.mjs"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.25.5",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "@tanstack/router-plugin": "^1.167.28",
    "lucide-react": "^0.575.0",
    "openai": "^6.37.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "unpdf": "^1.8.1",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^3.2.7"
  }
}
